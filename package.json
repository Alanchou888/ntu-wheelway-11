{
  "name": "ntu-wheelway",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-offline.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "data:refresh": "node scripts/refresh-data.mjs",
    "survey:template": "node scripts/create-survey-template.mjs",
    "survey:check": "tsx scripts/review-survey.ts"
  },
  "dependencies": {
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.3",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5"
  }
}
