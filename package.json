{
  "name": "ntu-wheelway",
  "private": true,
  "version": "2.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && node scripts/clean-build.mjs && vite build && node scripts/build-community.mjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.tools.json && tsc --project tsconfig.server.json",
    "preview": "node scripts/dev-community.mjs",
    "test": "vitest run",
    "data:refresh": "node scripts/refresh-data.mjs",
    "places:refresh": "node scripts/refresh-places.mjs",
    "survey:template": "node scripts/create-survey-template.mjs",
    "survey:check": "tsx scripts/review-survey.ts",
    "dev:api": "node scripts/dev-community.mjs",
    "start": "node scripts/dev-community.mjs",
    "db:generate": "drizzle-kit generate",
    "db:local": "node scripts/migrate-community.mjs"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260515.1",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^26.6.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "axe-core": "^4.10.3",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.12",
    "fake-indexeddb": "^6.2.6",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.92.0"
  }
}
